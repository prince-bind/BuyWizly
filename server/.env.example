ENV=dev
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-before-deploying
# SQLite for local dev; use your Neon connection string in production
DATABASE_URL=sqlite:///./shopsmart.db

# Free key from https://console.groq.com - the app still works without it (extractive fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# auto | chroma | memory
#  auto   = Chroma Cloud when CHROMA_API_KEY is set (local Chroma in dev), otherwise in-memory search
#  memory = built-in TF-IDF search, no extra service
VECTOR_BACKEND=auto
CHROMA_PATH=./data/chroma
# Chroma Cloud (optional). With a key set, embeddings are computed by Chroma's hosted model.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# comma-separated; these users become admins (existing users are promoted on startup)
ADMIN_EMAILS=
# true = create the shared, non-admin demo@shopsmart.ai account with sample orders
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173
